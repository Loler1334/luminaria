# Add these values in Cloudflare Pages → Settings → Variables and Secrets.
# The Supabase publishable key is intended for browser use; database access is
# protected by Supabase Authentication and Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
