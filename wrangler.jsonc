{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luminaria",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-01-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/privacy", "/privacy/", "/terms", "/terms/"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "ai": { "binding": "AI" }
}
